---
import CopyQuestions from './CopyQuestions.astro';
import PageActions from './PageActions.astro';
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';
const { entry } = Astro.locals.starlightRoute;
const isMk = Astro.locals.starlightRoute.locale === 'mk';
const localeRoot = import.meta.env.BASE_URL + (isMk ? 'mk/' : '');
const relativePage = Astro.url.pathname.slice(localeRoot.length).replace(/\/$/, '');
const isReference = relativePage.startsWith('reference/');
const isIntroduction = Astro.url.pathname.replace(/\/$/, '') === localeRoot.replace(/\/$/, '');
---

{(isIntroduction || isReference) && (
  <nav class="page-path" aria-label={isMk ? 'Патека на страницата' : 'Breadcrumb'}>
    <span>{isReference ? (isMk ? 'Референца' : 'Reference') : (isMk ? 'Започнете тука' : 'Get started')}</span>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
    <span aria-current="page">{entry.data.title}</span>
  </nav>
)}
<CopyQuestions />
<div class="title-row">
  <PageTitle />
  {(isIntroduction || isReference || relativePage === 'blog') && <PageActions url={import.meta.env.BASE_URL + 'markdown/' + (isMk ? 'mk/' : '') + (isIntroduction ? 'index' : relativePage === 'reference/tools' ? 'reference/tools/index' : relativePage) + '.md'} />}
</div>

<style>
  .title-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .page-path {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-family: var(--sl-font);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #6b6b6b;
  }

  svg { width: 0.875rem; height: 0.875rem; flex: none; }
  [aria-current='page'] { color: #a0a0a0; }
</style>
