---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';
const { entry } = Astro.locals.starlightRoute;
const isIntroduction = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
---

{isIntroduction && (
  <nav class="page-path" aria-label="Breadcrumb">
    <span>Get started</span>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
    <span aria-current="page">{entry.data.title}</span>
  </nav>
)}
<PageTitle />

<style>
  .page-path {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-family: var(--sl-font);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #6b6b6b;
  }

  svg { width: 0.875rem; height: 0.875rem; flex: none; }
  [aria-current='page'] { color: #a0a0a0; }
</style>
