---
const stages = [
  { title: 'Your MCP client', detail: 'You ask a question in your chat.', path: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z' },
  { title: 'Courses MCP', detail: 'A local server reads the relevant course information.', path: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01' },
  { title: 'FINKI Moodle', detail: 'The source is a course your faculty account can access.', path: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 3H20v19H6.5A2.5 2.5 0 0 1 4 19.5v-14A2.5 2.5 0 0 1 6.5 3Z' },
];
---
<figure aria-label="Your MCP client connects to a local Courses MCP server, which reads authorized FINKI Moodle courses.">
  <div class="connection-flow">
    {stages.map((stage) => (
      <div class="stage">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={stage.path} /></svg>
        <strong>{stage.title}</strong>
        <p>{stage.detail}</p>
      </div>
    ))}
  </div>
  <figcaption>Course information returns through the server to your MCP client.</figcaption>
</figure>
<style>
  figure { margin: 1rem 0; }
  .connection-flow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .stage { margin: 0; padding: 1rem; border: 1px solid #303034; border-radius: 1rem; background: #171719; }
  svg { display: block; width: 1.5rem; height: 1.5rem; margin-bottom: 1rem; color: #b9bdff; }
  strong { color: var(--sl-color-white); font-size: 0.9rem; }
  p, figcaption { font-size: 0.85rem; line-height: 1.6; color: var(--sl-color-gray-2); }
  p { margin: 0.5rem 0 0; }
  figcaption { margin-top: 0.75rem; }
  @media (max-width: 42rem) { .connection-flow { grid-template-columns: 1fr; } }
</style>
