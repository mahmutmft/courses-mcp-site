<script>
  document.querySelectorAll<HTMLLIElement>('.example-questions li').forEach((row) => {
    const text = row.textContent?.trim() ?? '';
    const isMk = document.documentElement.lang === 'mk';
    const label = isMk ? 'Копирај прашање' : 'Copy question';
    const copied = isMk ? 'Копирано' : 'Copied';
    const failure = isMk ? 'Копирањето не успеа. Копирајте го текстот рачно.' : 'Copy failed. Copy the text manually.';
    const content = document.createElement('span');
    content.className = 'question-text';
    content.append(...row.childNodes);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-question';
    button.setAttribute('aria-label', label);
    button.title = label;
    button.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>';
    const status = document.createElement('span');
    status.className = 'sr-only';
    status.setAttribute('role', 'status');
    row.append(content, button, status);
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        button.dataset.copied = 'true';
        button.setAttribute('aria-label', copied);
        button.title = copied;
        status.textContent = copied;
        clearTimeout(timer);
        timer = setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', label);
          button.title = label;
          status.textContent = '';
        }, 2000);
      } catch {
        status.textContent = failure;
        button.title = failure;
      }
    });
  });
</script>

<style is:global>
  .example-questions .question-text {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .example-questions .copy-question {
    display: grid;
    place-items: center;
    flex: none;
    margin: -0.25rem -0.375rem -0.25rem 0;
    padding: 0.375rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: #a0a0a0;
    cursor: pointer;
  }

  .copy-question svg { width: 14px; height: 14px; }
  .copy-question:hover { background: #2a2a2a; color: #e8e8e8; }
  .copy-question[data-copied] { color: #5b8ef0; }
  .copy-question:focus-visible { outline: 2px solid #5b8ef0; outline-offset: 2px; }

  @media (pointer: coarse) {
    .example-questions .copy-question { width: 2.75rem; height: 2.75rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .copy-question { transition: background-color 150ms ease, color 150ms ease; }
  }
</style>
