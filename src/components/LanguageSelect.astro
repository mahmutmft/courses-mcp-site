---
const isMk = Astro.locals.starlightRoute.locale === 'mk';
const base = import.meta.env.BASE_URL;
const relative = Astro.url.pathname.slice(base.length).replace(/^mk\/?/, '');
const englishUrl = base + relative;
const macedonianUrl = base + 'mk/' + relative;
---
<details class="language-picker">
  <summary aria-label={isMk ? 'Изберете јазик на документацијата' : 'Choose documentation language'}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18" /></svg>
    {isMk ? 'MK' : 'EN'}
    <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <ul aria-label={isMk ? 'Јазици на документацијата' : 'Documentation languages'}>
    <li class:list={{ current: !isMk }}><a href={englishUrl} lang="en" hreflang="en" aria-current={!isMk ? "page" : undefined}>English <span class="code">EN</span></a></li>
    <li class:list={{ current: isMk }}><a href={macedonianUrl} lang="mk" hreflang="mk" aria-current={isMk ? "page" : undefined}>Македонски <span class="code">MK</span></a></li>
    <li><span lang="tr">Türkçe</span><small>{isMk ? 'Наскоро' : 'Coming soon'}</small></li>
    <li><span lang="sq">Shqip</span><small>{isMk ? 'Наскоро' : 'Coming soon'}</small></li>
  </ul>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.language-picker').forEach((picker) => {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
    });
    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false;
        picker.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .language-picker { position: relative; font-family: var(--sl-font); font-size: 0.9375rem; }
  summary { display: flex; align-items: center; gap: 0.5rem; min-height: 2.25rem; padding: 0.375rem; border: 1px solid transparent; border-radius: 6px; color: #e8e8e8; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, details[open] summary { background: #1e1e1e; color: #e8e8e8; border-color: #2a2a2a; }
  summary:focus-visible { outline: 2px solid #5b8ef0; outline-offset: 2px; }
  svg { width: 1rem; height: 1rem; flex: none; }
  .chevron { width: 0.75rem; }
  ul { position: absolute; z-index: 10; inset-inline-end: 0; top: calc(100% + 0.5rem); min-width: 14rem; margin: 0; padding: 0.375rem; list-style: none; border: 1px solid #2a2a2a; border-radius: 10px; background: #171717; box-shadow: 0 12px 35px rgb(0 0 0 / 30%); }
  li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.625rem 0.75rem; border-radius: 6px; color: #a0a0a0; }
  li:has(a) { padding: 0; }
  a { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0.625rem 0.75rem; color: inherit; text-decoration: none; border-radius: 6px; }
  a:hover { background: #232323; }
  .current { background: #1e1e1e; color: #e8e8e8; }
  .code { color: #5b8ef0; font-size: 0.6875rem; }
  small { color: #6b6b6b; font-size: 0.6875rem; }
  @media (max-width: 49.999rem) { ul { top: auto; bottom: calc(100% + 0.5rem); } }
  @media (prefers-reduced-motion: no-preference) {
    details[open] ul { animation: language-open 120ms ease-out; }
    @keyframes language-open { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
