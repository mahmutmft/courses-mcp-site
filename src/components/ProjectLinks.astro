---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsUrl = base + '/docs/';
const blogUrl = base + '/blog/';
---

<nav class="project-links" aria-label="Project links">
  <a href={docsUrl} aria-label="Docs">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 7v14M3 18V4h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v14h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3H3Z" />
    </svg>
    <span>Docs</span>
  </a>
  <a href="https://github.com/mahmutmft/courses-mcp" aria-label="GitHub">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22" />
    </svg>
    <span>GitHub</span>
  </a>
  <a href={blogUrl} aria-label="Blog">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
      <circle cx="5" cy="19" r="1" />
    </svg>
    <span>Blog</span>
  </a>
</nav>

<style>
  .project-links,
  a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  a {
    padding: 0.375rem;
    color: var(--sl-color-text);
    text-decoration: none;
    border-radius: 0.375rem;
  }

  a:hover {
    background: var(--sl-color-bg-inline-code);
  }

  svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 49.999rem) {
    span {
      display: none;
    }
  }
</style>
