---
interface Props { url: string }
const { url } = Astro.props;
const isMk = Astro.locals.starlightRoute.locale === 'mk';
const labels = isMk ? { copy: 'Копирај страница', copied: 'Копирано', success: 'Страницата е копирана како Markdown.', failure: 'Копирањето не успеа. Отворете ја Markdown верзијата за рачно копирање.' } : { copy: 'Copy page', copied: 'Copied', success: 'Page copied as Markdown.', failure: 'Copy failed. Use View as Markdown to copy the text manually.' };
---
<div class="page-actions">
  <button type="button" data-copy-url={url} data-labels={JSON.stringify(labels)}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
    <span>{labels.copy}</span>
  </button>
  <details>
    <summary aria-label={isMk ? 'Повеќе дејства за страницата' : 'More page actions'}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg></summary>
    <a href={url} target="_blank" rel="noopener">{isMk ? 'Прикажи како Markdown' : 'View as Markdown'}</a>
  </details>
  <span class="sr-only" role="status"></span>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach((button) => {
    let timer: ReturnType<typeof setTimeout>;
    const labels = JSON.parse(button.dataset.labels!);
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector('[role="status"]');
      try {
        const response = await fetch(button.dataset.copyUrl!);
        if (!response.ok) throw new Error('Markdown unavailable');
        await navigator.clipboard.writeText(await response.text());
        button.querySelector('span')!.textContent = labels.copied;
        if (status) status.textContent = labels.success;
        clearTimeout(timer);
        timer = setTimeout(() => { button.querySelector('span')!.textContent = labels.copy; }, 2000);
      } catch {
        if (status) status.textContent = labels.failure;
      }
    });
  });
</script>
<style>
  .page-actions {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: stretch;
    align-self: center;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    background: #0e0e0e;
    color: #a0a0a0;
    font-family: "Geist Variable", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
  }

  button, summary {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    margin: 0;
    padding: 0.375rem 0.625rem;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  button:hover, summary:hover, details[open] summary {
    color: #e8e8e8;
    background: #1e1e1e;
  }

  button:focus-visible, summary:focus-visible, a:focus-visible {
    outline: 2px solid #5b8ef0;
    outline-offset: 3px;
  }

  svg { display: block; width: 14px; height: 14px; flex: none; }
  details { border-inline-start: 1px solid #2a2a2a; }
  summary { width: 1.875rem; padding-inline: 0.375rem; list-style: none; }
  summary::-webkit-details-marker { display: none; }

  a {
    position: absolute;
    z-index: 5;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    min-width: 11rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    background: #171717;
    color: #a0a0a0;
    box-shadow: 0 12px 35px rgb(0 0 0 / 30%);
    white-space: nowrap;
    text-decoration: none;
  }

  a:hover { color: #e8e8e8; background: #1e1e1e; }

  @media (prefers-reduced-motion: no-preference) {
    button, summary, a { transition: background-color 150ms ease, color 150ms ease; }
  }

  @media (max-width: 49.999rem) {
    button, summary { min-height: 2.75rem; }
  }
</style>